# ─────────────────────────────────────────────────────────────
# FlowEngine — environment variables
# Copy to .env (local) or paste into Vercel → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Database (Turso / libSQL) — REQUIRED ──
# Create a free database at https://turso.tech → turso db create flowengine
# Then copy the URL and generate a token: turso db tokens create flowengine
TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ── Auth & crypto — REQUIRED in production ──
# Signs session JWTs and encrypts integration secrets (SMTP passwords, API keys).
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-string
# Optional alias used by some deploy guides; JWT_SECRET takes precedence:
# NEXTAUTH_SECRET=

# ── Automation engine ──
# Secret shared with the engine tick endpoint and the optional external engine.
# Vercel Cron automatically sends "Authorization: Bearer <CRON_SECRET>" when set.
CRON_SECRET=replace-with-a-long-random-string
ENGINE_SECRET=replace-with-another-random-string

# ── External engine service (OPTIONAL) ──
# Leave unset on Vercel — the built-in in-process runner handles the queue.
# Set only when self-hosting the FastAPI sidecar (mini-services/automation-engine).
# ENGINE_URL=http://localhost:3030
# NEXTJS_BASE=http://localhost:3000
